rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only a logged-in user (your admin email) can read/write anything.
    // Good enough for a single-teacher tool. See README for tightening
    // this further to one specific email address if you want.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
